--- !u!114 &996269957
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 996269955}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dc1571e17aedf407ab2f6c99b8394ce1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RR.HotspotBehaviour
  datos:
    id: cocinero
    nombre: Cocinero
    x: -14
    y: 0
    z: 4
    ancho: 0.9
    alto: 1.72
    prof: 0.6
    forma: persona
    color: '#a89078'
    mirar: "Sentado en un caj\xF3n dado vuelta, fumando, con el delantal manchado.
      Treinta a\xF1os d\xE1ndole de comer a gente que se va."
    setFlagAlMirar: 
    usarSolo: 
    setFlagAlUsar: 
    hablar:
    - quien: cocinero
      texto: "\xABLa del Hermitage. Ya le dije. Y si ve a mi sobrino adentro, m\xE1ndemelo
        a casa.\xBB"
      requiereFlag: se_la_entrada
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones: []
    - quien: cocinero
      texto: "\xAB\xBFUsted tambi\xE9n viene a tomar el Palacio? Van cuatro esta
        noche.\xBB\n\nSe r\xEDe sin ganas.\n\n\xABLes hice la cena a los ministros
        a las siete. No comieron. Est\xE1n todos sentados esperando que los vengan
        a buscar y yo no me puedo ir porque nadie me dio permiso para irme.\xBB"
      requiereFlag: 
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones:
      - texto: "V\xE1yase a su casa, compa\xF1ero. Nadie va a preguntar."
        respuesta: "Se queda pensando. Apaga el cigarrillo contra el caj\xF3n.\n\n\xAB\u2026\xBFNadie?\xBB\n\n\xABNadie.\xBB\n\nSe
          saca el delantal, lo dobla \u2014lo dobla, despu\xE9s de todo\u2014 y antes
          de irse me dice por encima del hombro:\n\n\xABLa puerta del lado del Hermitage
          no la cuida nadie. Nunca la cuid\xF3 nadie. Es por donde entramos nosotros
          hace treinta a\xF1os.\xBB"
        quienResponde: cocinero
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: 
        setFlag: se_la_entrada
        daItem: 
        consumeItem: 
        abreDuelo: 
        ejeConviccion: 1
        ejeMetodo: 0
        cierra: 1
      - texto: "\xBFPor d\xF3nde se entra?"
        respuesta: "\xAB\xBFY a m\xED qu\xE9 me va en eso?\xBB\n\nSe da vuelta. Tiene
          raz\xF3n: no le va nada."
        quienResponde: cocinero
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: 
        setFlag: 
        daItem: 
        consumeItem: 
        abreDuelo: 
        ejeConviccion: 0
        ejeMetodo: 0
        cierra: 1
    usos: []
    daItemAlUsar: 
    ocultarSiFlag: 
    mostrarSiFlag: 
    vaA: 
    requiereFlagParaIr: 
    textoSiNoPuedeIr: 
  bloqueadoParaReimportar: 0
