  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RR.HotspotBehaviour
  datos:
    id: salones
    nombre: Enfilada de salones
    x: 2
    y: 0
    z: 10
    ancho: 10
    alto: 5
    prof: 4
    forma: caja
    color: '#7a6a5a'
    mirar: "Mil quinientas habitaciones. Mil setecientas ochenta y seis puertas.
      Parqu\xE9 encerado, ara\xF1as apagadas, cuadros de gente muerta mirando desde
      arriba.\n\nEstoy perdida hace veinte minutos.\n\nPero se escucha algo. Abajo,
      a la izquierda. Ruido de vidrio y hombres cantando mal."
    setFlagAlMirar: 
    usarSolo: "Sigo el ruido. Es el \xFAnico mapa que tengo."
    setFlagAlUsar: encontre_bodega
    hablar: []
    usos: []
    daItemAlUsar: 
    ocultarSiFlag: 
    mostrarSiFlag: entre_al_palacio
    vaA: 
    requiereFlagParaIr: 
    textoSiNoPuedeIr: 
  bloqueadoParaReimportar: 0
