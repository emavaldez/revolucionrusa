--- !u!114 &429062843
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 429062841}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dc1571e17aedf407ab2f6c99b8394ce1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RR.HotspotBehaviour
  datos:
    id: gobierno
    nombre: "Comedor Peque\xF1o"
    x: 31
    y: 0
    z: 8
    ancho: 6
    alto: 3
    prof: 4
    forma: caja
    color: '#5f5347'
    mirar: "Trece ministros del Gobierno Provisional de Rusia sentados alrededor
      de una mesa, con los abrigos puestos, esperando.\n\nHay un reloj que anda.
      Son las dos y diez.\n\nPrepar\xE9 un duelo dial\xE9ctico para este momento.
      Tengo ocho argumentos en la libreta, tres de ellos de M\xE1rtov.\n\nNo hay
      con qui\xE9n discutir. Ya se rindieron. Se rindieron hace horas y se quedaron
      sentados porque no sab\xEDan qu\xE9 otra cosa hacer."
    setFlagAlMirar: 
    usarSolo: 
    setFlagAlUsar: 
    hablar:
    - quien: konovalov
      texto: "Uno de los ministros levanta la vista.\n\n\xAB\xBFSon ustedes? Muy
        bien. Hagan lo que tengan que hacer.\xBB\n\nAnt\xF3nov-Ovs\xE9yenko entra
        atr\xE1s m\xEDo, con el sombrero de ala ancha, y empieza a leer la f\xF3rmula
        del arresto. Alguien busca papel para el acta.\n\nEl papel me lo dan a m\xED.
        Porque soy la que sabe escribir."
      requiereFlag: 
      requiereNoFlag: 
      requiereItem: 
      setFlag: tengo_acta
      daItem: acta
      consumeItem: 
      abreDuelo: 
      opciones:
      - texto: "(Escribir) \xABSe tom\xF3 el Palacio por asalto tras dura resistencia.\xBB"
        respuesta: "Lo escribo as\xED. Queda bien. Es \xE9pico, es claro, y es lo
          que va a hacer falta contar ma\xF1ana en las f\xE1bricas para que valga
          la pena.\n\nNo hubo dura resistencia. Hubo una botella de Sauternes y un
          chico de diecisiete a\xF1os.\n\nPero esto lo van a leer durante cien a\xF1os,
          y lo que se escribe es lo que pas\xF3."
        quienResponde: 
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: 
        setFlag: acta_epica
        daItem: 
        consumeItem: 
        abreDuelo: 
        ejeConviccion: 0
        ejeMetodo: 2
        cierra: 1
      - texto: "(Escribir) \xABSe entr\xF3 por la puerta de servicio. Los ministros
          esperaban sentados.\xBB"
        respuesta: "Lo escribo as\xED. Tal cual.\n\nEl compa\xF1ero que me mira por
          encima del hombro chasquea la lengua.\n\n\xABEso no sirve, compa\xF1era.\xBB\n\n\xABEso
          pas\xF3, compa\xF1ero.\xBB\n\nNo s\xE9 si esa hoja va a sobrevivir a la
          semana. Pero fue verdad durante el rato en que estuvo escrita."
        quienResponde: 
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: 
        setFlag: acta_veraz
        daItem: 
        consumeItem: 
        abreDuelo: 
        ejeConviccion: 1
        ejeMetodo: -2
        cierra: 1
      - texto: (Escribir los nombres de todos los que estuvimos, uno por uno)
        respuesta: "Escribo los nombres. Todos. El marinero del Aurora, Liudmila
          la telefonista, Praskovia de la cola, el delegado del siete, el cocinero
          que se fue a su casa.\n\nY abajo de todo, con el l\xE1piz rojo, Nikol\xE1i
          Aleks\xE1ndrovich Rybin, de la Escuela Vlad\xEDmir, que cuidaba la \xFAltima
          puerta.\n\nNinguno de esos nombres va a aparecer en ning\xFAn libro. Por
          eso los escribo."
        quienResponde: 
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: 
        setFlag: acta_nombres
        daItem: 
        consumeItem: 
        abreDuelo: 
        ejeConviccion: 2
        ejeMetodo: -1
        cierra: 1
    usos: []
    daItemAlUsar: 
    ocultarSiFlag: 
    mostrarSiFlag: kolia_resuelto
    vaA: 
    requiereFlagParaIr: 
    textoSiNoPuedeIr: 
  bloqueadoParaReimportar: 0
