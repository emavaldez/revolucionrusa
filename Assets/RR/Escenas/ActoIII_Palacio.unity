  datos:
    id: puerta_servicio
    nombre: Puerta del Hermitage
    x: -6
    y: 0
    z: 9
    ancho: 1.4
    alto: 2.8
    prof: 0.4
    forma: puerta
    color: '#6b5b4b'
    mirar: "Una puerta de servicio del lado del Hermitage. Sin guardia. Sin cerrojo.
      Entreabierta.\n\nTreinta mil personas afuera esperando que alguien d\xE9 la
      orden de asaltar el Palacio, y la puerta estaba abierta."
    setFlagAlMirar: 
    usarSolo: "Entro caminando.\n\nCaminando. Como quien entra a una casa. Van a
      escribir mil libros sobre el asalto al Palacio de Invierno y yo entr\xE9 caminando
      por la puerta de servicio, sin sacarme el delantal."
    setFlagAlUsar: entre_al_palacio
    hablar: []
    usos: []
    daItemAlUsar: 
    ocultarSiFlag: 
    mostrarSiFlag: se_la_entrada
    vaA: 
    requiereFlagParaIr: 
    textoSiNoPuedeIr: 
  bloqueadoParaReimportar: 0
