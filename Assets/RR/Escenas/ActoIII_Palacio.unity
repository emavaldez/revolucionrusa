  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dc1571e17aedf407ab2f6c99b8394ce1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RR.HotspotBehaviour
  datos:
    id: bodega
    nombre: Bodega imperial
    x: 11
    y: 0
    z: 6
    ancho: 5
    alto: 3
    prof: 4
    forma: caja
    color: '#4a3a2a'
    mirar: "La bodega del Zar. Ch\xE2teau d'Yquem, Tokaji, borgo\xF1as de antes de
      que existiera el ferrocarril.\n\nY adentro, veinte de los nuestros y ocho junkers
      que vinieron a defenderla, todos igual de borrachos, cantando juntos.\n\nEl
      asalto al Palacio de Invierno se est\xE1 frenando ac\xE1 abajo. Nadie va a
      escribir esto."
    setFlagAlMirar: 
    usarSolo: "Agarro una botella del estante. Ch\xE2teau d'Yquem 1893, con el \xE1guila
      bic\xE9fala en la etiqueta.\n\nNo s\xE9 todav\xEDa para qu\xE9 la quiero. Algo
      me dice que s\xED."
    setFlagAlUsar: tengo_vino
    hablar: []
    usos: []
    daItemAlUsar: vino
    ocultarSiFlag: tengo_vino
    mostrarSiFlag: encontre_bodega
    vaA: 
    requiereFlagParaIr: 
    textoSiNoPuedeIr: 
  bloqueadoParaReimportar: 0
