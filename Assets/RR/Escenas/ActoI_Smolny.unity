    x: 27
    y: 0
    z: 2
    ancho: 1.6
    alto: 2.6
    prof: 0.4
    forma: puerta
    color: '#3f6f9f'
    mirar: "La puerta grande del Smolny. Del otro lado est\xE1 la ciudad, el r\xEDo,
      y un barrio donde la gente hace cola desde las cuatro de la ma\xF1ana."
    setFlagAlMirar: 
    usarSolo: 
    setFlagAlUsar: 
    hablar: []
    usos: []
    daItemAlUsar: 
    ocultarSiFlag: 
    mostrarSiFlag: 
    vaA: vyborg
    requiereFlagParaIr: tarea_dada
    textoSiNoPuedeIr: "Todav\xEDa no. Vine hasta ac\xE1 para que alguien me diera
      algo que hacer y nadie me dio nada todav\xEDa."
