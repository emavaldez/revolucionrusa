    prof: 0.6
    forma: persona
    color: '#8a8073'
    mirar: "Calvo, cincuenta y pico, abrigo bueno. Mira por la ventana el patio vac\xEDo.
      No lee nada."
    setFlagAlMirar: 
    usarSolo: 
    setFlagAlUsar: 
    hablar:
    - quien: calvo_a
      texto: "\xABEstoy esperando a mi cu\xF1ado, se\xF1orita. Hace tres horas.\xBB\n\nNo
        es \xE9l."
      requiereFlag: 
      requiereNoFlag: 
