  m_EditorClassIdentifier: Assembly-CSharp::RR.HotspotBehaviour
  datos:
    id: calvo_b
    nombre: Hombre calvo con gorra
    x: 6
    y: 0
    z: 5
    ancho: 0.8
    alto: 1.7
    prof: 0.6
    forma: persona
    color: '#7d7468'
    mirar: Gorra de obrero, calvo debajo. Lee el diario en voz baja, moviendo los
      labios, sin discutirle.
    setFlagAlMirar: 
    usarSolo: 
    setFlagAlUsar: 
    hablar:
    - quien: calvo_b
      texto: "\xAB\xBFEh? No, yo soy del sindicato de fundidores. Vine por lo del
        carb\xF3n.\xBB\n\nNo es \xE9l."
      requiereFlag: 
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
