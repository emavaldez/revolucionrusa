  datos:
    id: guardarropa
    nombre: Guardarropa del Instituto
    x: -17
    y: 0
    z: 5
    ancho: 3
    alto: 2.4
    prof: 1
    forma: caja
    color: '#6b5b4b'
    mirar: "Ciento veinte perchas numeradas. En casi todas cuelga todav\xEDa el delantal
      de una chica que se fue a Francia en marzo y no avis\xF3. Cada etiqueta est\xE1
      bordada a mano en cursiva francesa."
    setFlagAlMirar: 
    usarSolo: "Descuelgo uno. \xABM. A. Dolgor\xFAkaya, 3er curso\xBB, bordado con
      hilo de seda por alguien a quien le pagaron para eso.\n\nMe queda bien. Ese
      es el chiste m\xE1s amargo del d\xEDa."
    setFlagAlUsar: tengo_delantal
    hablar: []
    usos: []
    daItemAlUsar: delantal
    ocultarSiFlag: tengo_delantal
    mostrarSiFlag: sabe_letras_dificiles
    vaA: 
    requiereFlagParaIr: 
    textoSiNoPuedeIr: 
  bloqueadoParaReimportar: 0
