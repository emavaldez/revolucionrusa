--- !u!114 &225697483
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 225697481}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dc1571e17aedf407ab2f6c99b8394ce1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RR.HotspotBehaviour
  datos:
    id: martov
    nombre: "M\xE1rtov"
    x: 13
    y: 0
    z: 4
    ancho: 0.8
    alto: 1.78
    prof: 0.6
    forma: persona
    color: '#a0b8c9'
    mirar: "De pie sobre una tarima improvisada, habl\xE1ndole a una sala que lo
      escucha a medias. Tose cada tres frases. Va a tener raz\xF3n en todo y no le
      va a servir para nada."
    setFlagAlMirar: 
    usarSolo: 
    setFlagAlUsar: 
    hablar:
    - quien: martov
      texto: "\xABVolv\xE9 cuando tengas un argumento propio, compa\xF1era. Los m\xEDos
        ya los conozco.\xBB\n\nMe los llev\xE9 todos. No se dio cuenta."
      requiereFlag: perdi_con_martov
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones: []
    - quien: martov
      texto: "\xAB\u2026y por eso, compa\xF1eros, la aventura que se propone para
        esta semana no es una revoluci\xF3n: es un golpe con vocabulario marxista.\xBB\n\nLa
        sala murmura. Nadie lo interrumpe. Yo podr\xEDa interrumpirlo."
      requiereFlag: hay_te
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones:
      - texto: "(Interrumpirlo) Compa\xF1ero M\xE1rtov, con permiso."
        respuesta: "Se da vuelta despacio. Cuarenta cabezas se dan vuelta con \xE9l.\n\n\xABAdelante,
          compa\xF1era. La escucho.\xBB"
        quienResponde: martov
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: 
        setFlag: 
        daItem: 
        consumeItem: 
        abreDuelo: duelo_martov
        ejeConviccion: 0
        ejeMetodo: 0
        cierra: 0
      - texto: (Quedarme callada y escuchar)
        respuesta: "Sigue hablando veinte minutos m\xE1s. Tiene raz\xF3n en casi
          todo.\n\nEsa es exactamente su tragedia."
        quienResponde: martov
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: 
        setFlag: 
        daItem: 
        consumeItem: 
        abreDuelo: 
        ejeConviccion: 0
        ejeMetodo: 0
        cierra: 1
    - quien: martov
      texto: "\xAB\u2026y sin el apoyo de la democracia revolucionaria en su conjunto\u2026\xBB\n\nNo
        me ve. Nadie me ve todav\xEDa. Falta el t\xE9."
      requiereFlag: 
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones: []
    usos: []
    daItemAlUsar: 
    ocultarSiFlag: 
    mostrarSiFlag: paso_centinela
    vaA: 
    requiereFlagParaIr: 
    textoSiNoPuedeIr: 
  bloqueadoParaReimportar: 0
