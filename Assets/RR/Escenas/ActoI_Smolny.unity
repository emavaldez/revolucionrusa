--- !u!114 &1750255626
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1750255624}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dc1571e17aedf407ab2f6c99b8394ce1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RR.HotspotBehaviour
  datos:
    id: trotski
    nombre: Trotski
    x: 16
    y: 0
    z: 8
    ancho: 0.8
    alto: 1.78
    prof: 0.6
    forma: persona
    color: '#d94f3d'
    mirar: "Mesa del Comit\xE9 Militar Revolucionario. Tres tel\xE9fonos, dos de
      ellos descolgados. Habla como si alguien lo taquigrafiara, porque alguien lo
      est\xE1 taquigrafiando."
    setFlagAlMirar: 
    usarSolo: 
    setFlagAlUsar: 
    hablar:
    - quien: trotski
      texto: "\xAB\xBFTodav\xEDa ac\xE1? V\xFDborg queda al norte, compa\xF1era.\xBB"
      requiereFlag: tarea_dada
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones: []
    - quien: trotski
      texto: "\xABLa vi perder con M\xE1rtov.\xBB\n\nBaja la pluma.\n\n\xABPerdi\xF3
        bien. Perdi\xF3 anotando. En esta sala hay ochenta personas que ganan discusiones
        y ninguna anota.\xBB"
      requiereFlag: 
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones:
      - texto: Deme algo que hacer.
        respuesta: "\xABMa\xF1ana a la noche tomamos la ciudad y tengo tres agujeros.
          Uno: el Aurora no se mueve sin una orden firmada y yo no puedo firmarla
          sin que se entere medio Petrogrado. Dos: la central telef\xF3nica de Bolshaya
          Morskaya sigue hablando con el Palacio. Tres: Rech saca ma\xF1ana una edici\xF3n
          que nos llama agentes alemanes.\xBB\n\n\xABCruce a V\xFDborg. Resuelva
          lo que pueda. No me cuente c\xF3mo.\xBB\n\nEsa \xFAltima frase me la voy
          a acordar toda la vida."
        quienResponde: trotski
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: 
        setFlag: tarea_dada
        daItem: 
        consumeItem: 
        abreDuelo: 
        ejeConviccion: 0
        ejeMetodo: 0
        cierra: 1
      - texto: "\xBFY si ma\xF1ana sale mal?"
        respuesta: "\xABEntonces en veinte a\xF1os una se\xF1ora le va a contar a
          sus nietos que estuvo ac\xE1. Vaya a V\xFDborg.\xBB"
        quienResponde: trotski
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: 
        setFlag: tarea_dada
        daItem: 
        consumeItem: 
        abreDuelo: 
        ejeConviccion: -1
        ejeMetodo: 0
        cierra: 1
    usos: []
    daItemAlUsar: 
    ocultarSiFlag: 
    mostrarSiFlag: perdi_con_martov
    vaA: 
    requiereFlagParaIr: 
    textoSiNoPuedeIr: 
  bloqueadoParaReimportar: 0
