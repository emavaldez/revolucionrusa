  datos:
    id: muebles
    nombre: Muebles confiscados
    x: -6
    y: 0
    z: 6
    ancho: 3.5
    alto: 2
    prof: 2
    forma: caja
    color: '#5a4636'
    mirar: "Una pila de dos metros: sillas doradas, un piano vertical, cuatro retratos
      de zarinas apoyados contra la pared mirando al rev\xE9s. Confiscado a la direcci\xF3n
      del Instituto. Nadie decidi\xF3 todav\xEDa qu\xE9 se hace con esto."
    setFlagAlMirar: 
    usarSolo: "Le arranco una pata a la silla de la directora. Caoba maciza, del
      a\xF1o del \xF1aupa.\n\nEn alg\xFAn lugar de Par\xEDs, Madame se sentar\xEDa
      en esta silla para decirme que las manos de una mujer se ven mejor sin callos."
    setFlagAlUsar: tengo_pata
    hablar: []
    usos: []
    daItemAlUsar: pata_silla
    ocultarSiFlag: tengo_pata
    mostrarSiFlag: paso_centinela
    vaA: 
    requiereFlagParaIr: 
    textoSiNoPuedeIr: 
  bloqueadoParaReimportar: 0
