--- !u!114 &985119614
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 985119612}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dc1571e17aedf407ab2f6c99b8394ce1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RR.HotspotBehaviour
  datos:
    id: samovar
    nombre: Samovar
    x: -2
    y: 0
    z: 7
    ancho: 1
    alto: 1.2
    prof: 1
    forma: caja
    color: '#8a6a3a'
    mirar: "Samovar de Tula, cobre, cuarenta litros. Apagado. Al lado, un cartel
      escrito a mano: \xABEL COMIT\xC9 NO DELIBERA SIN T\xC9\xBB.\n\nNo hay carb\xF3n
      en Petrogrado desde agosto."
    setFlagAlMirar: 
    usarSolo: 
    setFlagAlUsar: 
    hablar: []
    usos:
    - item: pata_silla
      requiereFlag: 
      exito: "La pata de caoba entra justo. Prende con una llama alta y limpia, de
        madera cara.\n\nEl agua hierve en once minutos. Sirvo cuarenta tazas.\n\nLa
        revoluci\xF3n quemando el mundo viejo, literalmente, para tomar el t\xE9."
      fallo: 
      setFlag: hay_te
      daItem: 
      consume: 1
      ejeConviccion: 0
      ejeMetodo: 0
    - item: fajo_pravda
      requiereFlag: 
      exito: 
      fallo: "\xBFQuemar Pravda para hacer t\xE9? Stalin me mata. Y me mata con raz\xF3n."
      setFlag: 
      daItem: 
      consume: 0
      ejeConviccion: 0
      ejeMetodo: 0
    daItemAlUsar: 
    ocultarSiFlag: 
    mostrarSiFlag: paso_centinela
    vaA: 
    requiereFlagParaIr: 
    textoSiNoPuedeIr: 
  bloqueadoParaReimportar: 0
