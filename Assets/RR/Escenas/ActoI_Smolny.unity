--- !u!114 &667972846
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 667972844}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dc1571e17aedf407ab2f6c99b8394ce1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RR.HotspotBehaviour
  datos:
    id: stalin
    nombre: Mesa de Pravda
    x: 20
    y: 0
    z: 4
    ancho: 0.8
    alto: 1.72
    prof: 0.6
    forma: persona
    color: '#7d8a7a'
    mirar: "Un georgiano de bigote corrige pruebas de p\xE1gina con un l\xE1piz rojo.
      Tacha p\xE1rrafos enteros. Escribe poco. Tacha mucho.\n\nAl lado, un fajo de
      cuarenta Pravdas atados con piol\xEDn que nadie vino a buscar."
    setFlagAlMirar: 
    usarSolo: 
    setFlagAlUsar: 
    hablar:
    - quien: stalin
      texto: "\xABYa se los llev\xF3. Bien.\xBB\n\nNo levanta la vista del l\xE1piz."
      requiereFlag: tengo_fajo
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones: []
    - quien: stalin
      texto: "Sin levantar la vista:\n\n\xABUsted va a V\xFDborg. Ll\xE9veselos.\xBB\n\nSe\xF1ala
        el fajo con el l\xE1piz rojo."
      requiereFlag: 
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones:
      - texto: "No me pidieron repartir diarios, compa\xF1ero."
        respuesta: "Ahora s\xED levanta la vista. Dos segundos. Vuelve al l\xE1piz.\n\n\xABNadie
          pide nada. Se anota qui\xE9n hace y qui\xE9n no.\xBB\n\nSe anota. Anotado
          queda."
        quienResponde: stalin
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: 
        setFlag: tengo_fajo
        daItem: fajo_pravda
        consumeItem: 
        abreDuelo: 
        ejeConviccion: 0
        ejeMetodo: 0
        cierra: 1
      - texto: (Agarrar el fajo sin decir nada)
        respuesta: "\xABMm\xBB, dice.\n\nEs lo m\xE1s parecido a un elogio que va
          a salir de esa mesa."
        quienResponde: stalin
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: 
        setFlag: tengo_fajo
        daItem: fajo_pravda
        consumeItem: 
        abreDuelo: 
        ejeConviccion: 0
        ejeMetodo: 0
        cierra: 1
    usos:
    - item: delantal
      requiereFlag: 
      exito: 
      fallo: No. A este no.
      setFlag: 
      daItem: 
      consume: 0
      ejeConviccion: 0
      ejeMetodo: 0
    daItemAlUsar: 
    ocultarSiFlag: 
    mostrarSiFlag: tarea_dada
    vaA: 
    requiereFlagParaIr: 
    textoSiNoPuedeIr: 
  bloqueadoParaReimportar: 0
