--- !u!114 &217025788
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 217025786}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dc1571e17aedf407ab2f6c99b8394ce1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RR.HotspotBehaviour
  datos:
    id: centinela
    nombre: Centinela
    x: -12
    y: 0
    z: 2
    ancho: 0.8
    alto: 1.8
    prof: 0.6
    forma: persona
    color: '#9aa38c'
    mirar: "Veintid\xF3s a\xF1os, fusil Mosin m\xE1s alto que \xE9l, botas que no
      son suyas. Custodia la puerta de un colegio de se\xF1oritas como si fuera el
      Reichstag."
    setFlagAlMirar: 
    usarSolo: 
    setFlagAlUsar: 
    hablar:
    - quien: centinela
      texto: "Pase, compa\xF1era instructora. Hoy hay t\xE9."
      requiereFlag: paso_centinela
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones: []
    - quien: centinela
      texto: "A ver. \xBFY esto qu\xE9 es?"
      requiereFlag: 
      requiereNoFlag: 
      requiereItem: delantal
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones:
      - texto: (Mostrarle la etiqueta bordada) Credencial del Instituto. Tercer curso.
        respuesta: "Se queda mirando la cursiva un rato largo. Mueve los labios.
          No est\xE1 leyendo: est\xE1 esperando que las letras se ordenen solas.\n\n\xABEst\xE1
          en regla\xBB, dice al final, y se corre.\n\nNo me mira a los ojos al decirlo.
          Tardo media cuadra en entender por qu\xE9."
        quienResponde: centinela
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: 
        setFlag: paso_centinela
        daItem: 
        consumeItem: delantal
        abreDuelo: 
        ejeConviccion: 0
        ejeMetodo: 0
        cierra: 1
      - texto: "Es un delantal de colegiala, compa\xF1ero. No sab\xE9s leer, \xBFno?"
        respuesta: "Se pone colorado hasta las orejas.\n\n\xABEn mi aldea no hab\xEDa
          escuela, compa\xF1era.\xBB\n\nMe deja pasar igual. Eso es peor."
        quienResponde: centinela
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: 
        setFlag: paso_centinela
        daItem: 
        consumeItem: delantal
        abreDuelo: 
        ejeConviccion: 1
        ejeMetodo: 0
        cierra: 1
    - quien: centinela
      texto: "Sin propusk no entra nadie, compa\xF1era. Orden del Comit\xE9 Militar
        Revolucionario."
      requiereFlag: 
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones:
      - texto: "Vengo de V\xFDborg. Tres mil obreras me mandaron."
        respuesta: "\xABY yo vengo de Tambov y no me dejan entrar al sal\xF3n de
          actos. Papel, compa\xF1era. Algo con un sello. Algo escrito.\xBB"
        quienResponde: centinela
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: 
        setFlag: 
        daItem: 
        consumeItem: 
        abreDuelo: 
        ejeConviccion: 0
        ejeMetodo: 0
        cierra: 1
      - texto: "\xBFQu\xE9 tiene que decir el papel?"
        respuesta: "Duda. \xABTiene que\u2026 tener letras. De las dif\xEDciles.
          Las que hacen los que mandan.\xBB\n\nAnotado."
        quienResponde: centinela
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: 
        setFlag: sabe_letras_dificiles
        daItem: 
        consumeItem: 
        abreDuelo: 
        ejeConviccion: 0
        ejeMetodo: 0
        cierra: 1
    usos: []
    daItemAlUsar: 
    ocultarSiFlag: 
    mostrarSiFlag: 
    vaA: 
    requiereFlagParaIr: 
    textoSiNoPuedeIr: 
  bloqueadoParaReimportar: 0
