--- !u!114 &845750431
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 845750429}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dc1571e17aedf407ab2f6c99b8394ce1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RR.HotspotBehaviour
  datos:
    id: aurora
    nombre: Crucero Aurora
    x: 22
    y: 0
    z: 10
    ancho: 9
    alto: 4
    prof: 3
    forma: caja
    color: '#4a5a66'
    mirar: "Amarrado en el Nev\xE1, gris contra el agua negra. Seis mil toneladas
      y catorce ca\xF1ones apuntando a una ciudad que ma\xF1ana cambia de due\xF1o.\n\nEl
      comit\xE9 del barco no se mueve sin una orden firmada."
    setFlagAlMirar: 
    usarSolo: 
    setFlagAlUsar: 
    hablar:
    - quien: marinero
      texto: "\xABA las nueve y cuarenta, compa\xF1era. Salva de fogueo. Que nadie
        se asuste: no vamos a tirarle al Hermitage.\xBB"
      requiereFlag: aurora_conseguido
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones: []
    - quien: marinero
      texto: "\xABSin firma no nos movemos. Ya nos enga\xF1aron en julio.\xBB"
      requiereFlag: aurora_negado
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones: []
    - quien: marinero
      texto: "\xABTraiga la orden, compa\xF1era.\xBB\n\nLe doy el papel. Lo da vuelta.
        Lo mira contra el farol.\n\n\xABAc\xE1 no hay firma. Un papel sin firma no
        es nada. En julio nos movieron con un papel sin firma y nos cazaron a doscientos.\xBB"
      requiereFlag: 
      requiereNoFlag: 
      requiereItem: orden_aurora
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones:
      - texto: "(Marcarla con el l\xE1piz rojo de Stalin, como las pruebas de Pravda)"
        respuesta: "Hago la marca. Dos trazos rojos en diagonal en el margen superior,
          igual que las pruebas de p\xE1gina del Smolny.\n\nEl marinero la mira.
          Reconoce la marca. Todo el mundo en Petrogrado conoce esa marca.\n\n\xABAh,
          bueno. Eso ya es otra cosa.\xBB\n\nNo firm\xE9 nada. S\xF3lo dibuj\xE9
          dos rayas. Me lo repito varias veces camino al puente."
        quienResponde: marinero
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: lapiz_rojo
        setFlag: aurora_conseguido
        daItem: 
        consumeItem: orden_aurora
        abreDuelo: 
        ejeConviccion: 0
        ejeMetodo: 2
        cierra: 1
      - texto: "Tiene raz\xF3n. Vuelvo cuando tenga una firma de verdad."
        respuesta: "\xABAs\xED se habla, compa\xF1era.\xBB\n\nNo vuelvo. No hay tiempo
          para volver y los dos lo sabemos. Ma\xF1ana el Aurora no se mueve y el
          Palacio hay que tomarlo de otra manera."
        quienResponde: marinero
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: 
        setFlag: aurora_negado
        daItem: 
        consumeItem: orden_aurora
        abreDuelo: 
        ejeConviccion: -1
        ejeMetodo: -2
        cierra: 1
    - quien: marinero
      texto: "\xAB\xBFTrae orden del Comit\xE9? Porque sin orden, nada.\xBB\n\nNo
        tengo la orden. Trotski dijo que la resolviera yo."
      requiereFlag: 
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones: []
    usos: []
    daItemAlUsar: 
    ocultarSiFlag: 
    mostrarSiFlag: 
    vaA: 
    requiereFlagParaIr: 
    textoSiNoPuedeIr: 
  bloqueadoParaReimportar: 0
