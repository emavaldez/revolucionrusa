  datos:
    id: salida_vyborg
    nombre: Camino al Palacio
    x: 39
    y: 0
    z: 3
    ancho: 2
    alto: 2.6
    prof: 0.4
    forma: puerta
    color: '#3f6f9f'
    mirar: "Al sur, cruzando el r\xEDo, la Plaza del Palacio. Ah\xED est\xE1 el Gobierno
      Provisional esperando que alguien venga a buscarlo."
    setFlagAlMirar: 
    usarSolo: 
    setFlagAlUsar: 
    hablar: []
    usos: []
    daItemAlUsar: 
    ocultarSiFlag: 
    mostrarSiFlag: 
    vaA: palacio
    requiereFlagParaIr: cadete_comio
    textoSiNoPuedeIr: "Todav\xEDa no cruzo. El puente est\xE1 cortado y hay cosas
      ac\xE1 sin resolver."
  bloqueadoParaReimportar: 0
