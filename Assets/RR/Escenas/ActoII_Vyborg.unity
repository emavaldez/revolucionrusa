  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RR.HotspotBehaviour
  datos:
    id: mesa_orden
    nombre: "Mesa del comit\xE9 de f\xE1brica"
    x: 17
    y: 0
    z: 4
    ancho: 2
    alto: 0.9
    prof: 1.2
    forma: caja
    color: '#5f5347'
    mirar: "Una mesa con papel membretado del Comit\xE9 Militar Revolucionario, robado,
      y un tintero helado.\n\nPuedo redactar la orden. Redactarla no es el problema."
    setFlagAlMirar: 
    usarSolo: "Escribo la orden para el Aurora. Tres l\xEDneas, claras, sin adjetivos.\n\nAbajo
      queda el espacio de la firma, blanco, mir\xE1ndome."
    setFlagAlUsar: tengo_orden
    hablar: []
    usos: []
    daItemAlUsar: orden_aurora
    ocultarSiFlag: tengo_orden
    mostrarSiFlag: tranvia_conseguido
    vaA: 
    requiereFlagParaIr: 
    textoSiNoPuedeIr: 
  bloqueadoParaReimportar: 0
