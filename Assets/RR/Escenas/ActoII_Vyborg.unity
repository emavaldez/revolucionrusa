--- !u!114 &429062843
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 429062841}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dc1571e17aedf407ab2f6c99b8394ce1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RR.HotspotBehaviour
  datos:
    id: imprenta
    nombre: Imprenta de Rech
    x: 31
    y: 0
    z: 7
    ancho: 6
    alto: 4
    prof: 4
    forma: caja
    color: '#6a5f52'
    mirar: "La rotativa de Rech, el diario de los kadetes. La edici\xF3n de ma\xF1ana
      dice que somos agentes alemanes pagados por el Estado Mayor.\n\nLa prensa est\xE1
      a tres metros de la puerta. Una barra de hierro y no sale ninguna edici\xF3n
      nunca m\xE1s."
    setFlagAlMirar: 
    usarSolo: 
    setFlagAlUsar: 
    hablar:
    - quien: editor
      texto: "\xABBuenas noches, se\xF1orita. Y que Dios los agarre confesados.\xBB"
      requiereFlag: imprenta_convencida
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones: []
    - quien: editor
      texto: No hay nadie. Hay una prensa rota y tinta en el piso.
      requiereFlag: imprenta_rota
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones: []
    - quien: editor
      texto: "La rotativa ya est\xE1 andando. Se escucha desde la vereda."
      requiereFlag: imprenta_sale
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones: []
    - quien: editor
      texto: "El editor no se levanta de la silla. Tiene la prueba de p\xE1gina en
        la mano.\n\n\xABLa edici\xF3n sale en cuarenta minutos, se\xF1orita. \xBFViene
        a romperme la prensa o viene a discutir?\xBB"
      requiereFlag: 
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones:
      - texto: Vengo a discutir.
        respuesta: "Deja la prueba sobre el escritorio y se acomoda en la silla.\n\n\xABExcelente.
          Hace meses que nadie discute. Todos rompen.\xBB"
        quienResponde: editor
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: 
        setFlag: 
        daItem: 
        consumeItem: 
        abreDuelo: duelo_editor
        ejeConviccion: 0
        ejeMetodo: 0
        cierra: 0
      - texto: (Agarrar la barra de hierro)
        respuesta: "Tres golpes en el cilindro y la rotativa de Rech no imprime m\xE1s.\n\nEl
          editor no se mueve de la silla. Me mira hacerlo, con las manos cruzadas
          sobre la prueba de p\xE1gina, y cuando termino dice, muy tranquilo:\n\n\xABGracias.
          Ahora ya s\xE9 qu\xE9 son ustedes, y no tuve que escribirlo.\xBB\n\nTard\xF3
          cuatro segundos. Fue rapid\xEDsimo. Fue lo m\xE1s f\xE1cil de toda la noche."
        quienResponde: editor
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: 
        setFlag: imprenta_rota
        daItem: 
        consumeItem: 
        abreDuelo: 
        ejeConviccion: 0
        ejeMetodo: 2
        cierra: 1
    usos: []
    daItemAlUsar: 
    ocultarSiFlag: 
    mostrarSiFlag: tranvia_conseguido
    vaA: 
    requiereFlagParaIr: 
    textoSiNoPuedeIr: 
  bloqueadoParaReimportar: 0
