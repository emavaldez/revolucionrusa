--- !u!114 &634694015
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 634694013}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dc1571e17aedf407ab2f6c99b8394ce1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RR.HotspotBehaviour
  datos:
    id: puente
    nombre: "Puente Lit\xE9ini"
    x: 12
    y: 0
    z: 5
    ancho: 0.7
    alto: 1.68
    prof: 0.6
    forma: persona
    color: '#c0b0a0'
    mirar: "Un solo cadete cuidando el puente. Diecisiete a\xF1os, capote de la Escuela
      Vlad\xEDmir dos talles m\xE1s grande, fusil que no sabe si quiere.\n\nTiembla.
      Puede ser el fr\xEDo."
    setFlagAlMirar: 
    usarSolo: 
    setFlagAlUsar: 
    hablar:
    - quien: kolia
      texto: "\xABMe llamo Nikol\xE1i. Kolia.\xBB\n\nY despu\xE9s de un rato:\n\n\xABMi
        madre est\xE1 en Ts\xE1rskoye Sel\xF3. Si pasa algo, \xBFle puede avisar?
        Nikol\xE1i Aleks\xE1ndrovich Rybin. Es el \xFAnico Rybin de ah\xED.\xBB"
      requiereFlag: cadete_comio
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones: []
    - quien: kolia
      texto: "Me apunta con el fusil. Le tiembla tanto que el ca\xF1\xF3n hace c\xEDrculos.\n\n\xABAl-alto.
        Puente cerrado por orden del Gobierno Provisional.\xBB"
      requiereFlag: 
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones:
      - texto: "\xBFCu\xE1ndo comiste por \xFAltima vez?"
        respuesta: "El fusil baja diez cent\xEDmetros.\n\n\xAB\u2026ayer al mediod\xEDa.
          Nos mandaron sin rancho.\xBB\n\nY se queda ah\xED, apunt\xE1ndome mal,
          con hambre, cuidando un puente para un gobierno que se olvid\xF3 de darle
          de comer."
        quienResponde: kolia
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: 
        setFlag: 
        daItem: 
        consumeItem: 
        abreDuelo: 
        ejeConviccion: 0
        ejeMetodo: 0
        cierra: 1
      - texto: (Seguir de largo)
        respuesta: "\xAB\xA1Al-alto! \xA1Le digo alto!\xBB\n\nNo dispara. No va a
          disparar. Pero yo tampoco voy a pasar por arriba de un chico con un fusil."
        quienResponde: kolia
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: 
        setFlag: 
        daItem: 
        consumeItem: 
        abreDuelo: 
        ejeConviccion: 0
        ejeMetodo: 0
        cierra: 1
    usos:
    - item: pan_negro
      requiereFlag: 
      exito: "Le doy el pan.\n\nLo mira. Me mira. Lo agarra con las dos manos y come
        de parado, r\xE1pido, como comen los que tienen miedo de que se lo saquen.\n\nSe
        le llenan los ojos y hace como que es el viento.\n\nAcordate de esta cara,
        Verushka. Acordate."
      fallo: 
      setFlag: cadete_comio
      daItem: 
      consume: 1
      ejeConviccion: 1
      ejeMetodo: 0
    daItemAlUsar: 
    ocultarSiFlag: 
    mostrarSiFlag: 
    vaA: 
    requiereFlagParaIr: 
    textoSiNoPuedeIr: 
  bloqueadoParaReimportar: 0
