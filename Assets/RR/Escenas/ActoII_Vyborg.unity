--- !u!114 &698394631
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 698394629}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dc1571e17aedf407ab2f6c99b8394ce1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RR.HotspotBehaviour
  datos:
    id: tranvia
    nombre: "Tranv\xEDa parado"
    x: -6
    y: 0
    z: 7
    ancho: 6
    alto: 2.8
    prof: 2.2
    forma: caja
    color: '#7a4a3a'
    mirar: "El siete, parado en medio de la calle con las luces apagadas. Catorce
      m\xE1s atr\xE1s. Huelga por el aumento desde el lunes.\n\nEs la \xFAnica manera
      de cruzar la ciudad antes de que amanezca."
    setFlagAlMirar: 
    usarSolo: 
    setFlagAlUsar: 
    hablar:
    - quien: delegado
      texto: "\xABSub\xED, compa\xF1era. Y agarrate, que voy r\xE1pido.\xBB"
      requiereFlag: tranvia_conseguido
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones: []
    - quien: delegado
      texto: "\xABYa te dije que no. And\xE1 a pie.\xBB"
      requiereFlag: tranvia_negado
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones: []
    - quien: delegado
      texto: "El delegado del sindicato se para delante del estribo.\n\n\xABEst\xE1
        parado. Y va a seguir parado.\xBB"
      requiereFlag: 
      requiereNoFlag: 
      requiereItem: 
      setFlag: 
      daItem: 
      consumeItem: 
      abreDuelo: 
      opciones:
      - texto: "Necesito cruzar la ciudad esta noche. Es para ma\xF1ana."
        respuesta: "Se cruza de brazos. Detr\xE1s suyo, ochenta tipos mirando c\xF3mo
          termina esto."
        quienResponde: delegado
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: 
        setFlag: 
        daItem: 
        consumeItem: 
        abreDuelo: duelo_tranvia
        ejeConviccion: 0
        ejeMetodo: 0
        cierra: 0
      - texto: (Subirme igual y arrancarlo yo)
        respuesta: "Levanto el pie al estribo y me quedo as\xED.\n\nSoy obrera textil.
          Hace seis a\xF1os que paro el telar cuando el sindicato dice parar.\n\nBajo
          el pie. Hay cosas que no se hacen ni por la revoluci\xF3n, y romper una
          huelga ajena es la primera."
        quienResponde: delegado
        requiereFlag: 
        requiereNoFlag: 
        requiereItem: 
        setFlag: 
        daItem: 
        consumeItem: 
        abreDuelo: 
        ejeConviccion: 0
        ejeMetodo: -1
        cierra: 1
    usos: []
    daItemAlUsar: 
    ocultarSiFlag: 
    mostrarSiFlag: 
    vaA: 
    requiereFlagParaIr: 
    textoSiNoPuedeIr: 
  bloqueadoParaReimportar: 0
